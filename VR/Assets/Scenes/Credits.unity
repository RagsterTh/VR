    - target: {fileID: 3305217014372968175, guid: 29e4361e3dbb64e41a79612b30761213, type: 3}
      propertyPath: m_text
      value: "<B>Professores:</b>\n\r\nAlexandre da Silva Thiesen : Dire\xE7\xE3o
        da Programa\xE7\xE3o Back-end\n\r\nBruno Martins de Abreu : Dire\xE7\xE3o
        da Programa\xE7\xE3o Front-end\r\n\nClaudio Roberto Martins : Dire\xE7\xE3o
        de Som e Game Design\r\n\nDaniel Pinho Campos : Dire\xE7\xE3o Art\xEDstica\r\n\r\n<B>Alunos</b>\r\n\n<B>Game
        Designers:</b>\n\nArthur Veras Bonelli\n\nErick Lichtenfels Pudell\n\nArthur
        Lostada Martins\n\n<B>Programadores Back-End:</b>\n\nAnt\xF4nio Francisco
        dos Santos \n\nGustavo Serafim Manzoni \n\nRichard Bertan\n\nJulio Bernardo
        Silveira \n\n<B>Programadores Front-End:</b>\n\nPedro Gabriel Vicente\n\nGustavo
        Roncuni de Medeiros\r\n\n<B>3D:</b>\n\nArthur Lostada Martins\n\nBeatriz
        Ramirez dos Santos\n\nGabriel William Alves da Veiga\n\nRafael da Silva Correa\r\n\nLouise
        Scheibler Neckel \n\n<B>Sound Designer:</b>\n\nHeitor Avila Fochesato \r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7375217030836451758, guid: 29e4361e3dbb64e41a79612b30761213, type: 3}
